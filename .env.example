# Required: fill in connection settings. Never commit a real .env.
POSTGRES_HOST=postgres
POSTGRES_DB=app
POSTGRES_USER=backup
POSTGRES_PASSWORD=
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: uncomment to override defaults.
# POSTGRES_PORT=5432
# BACKUP_S3_REGION=ru-1
# BACKUP_S3_PREFIX=postgres-backups/production
# BACKUP_KEEP=30
# BACKUP_MANUAL_KEEP=30
# BACKUP_PREDEPLOY_KEEP=30
# BACKUP_TIME=17:00
# BACKUP_TIMEZONE=Europe/Moscow
# BACKUP_DUMP_TIMEOUT=1800
# BACKUP_RETRY_INTERVAL=300
# BACKUP_POLL_INTERVAL=60
# BACKUP_STATE_DIR=/state
# BACKUP_ALLOW_HTTP=0
# AWS_SESSION_TOKEN=
